# ═══════════════════════════════════════════════════════════════════════════
# ENVIRONMENT VARIABLES TEMPLATE
#
# SETUP:
#   1. Copy this file to .env.local for local development
#   2. Fill in your actual values
#   3. Never commit .env.local — it is gitignored
#
# LOCAL DEV vs PRODUCTION:
#   • .env.local         → for your machine only (gitignored)
#   • .env.production    → committed, non-secret production overrides only
#   • Vercel/hosting     → set secret keys (CLERK_SECRET_KEY, STRIPE_SECRET_KEY, etc.)
#                          in your hosting provider's dashboard, not in any file
#
# CLERK — LOCAL DEV REQUIREMENT:
#   Clerk live keys (pk_live_...) only work on domains explicitly allowlisted.
#   For localhost, EITHER:
#     A) Create a separate Clerk development instance (recommended):
#        → dashboard.clerk.com → Create application → choose Development
#        → copy the pk_test_... key and use it in .env.local
#     B) Allowlist localhost on your production Clerk instance:
#        → dashboard.clerk.com → Your instance → Configure → Domains
#        → Add http://localhost:3000 as an allowed host
# ═══════════════════════════════════════════════════════════════════════════

# ─── Convex Backend ────────────────────────────────────────────────────────
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# ─── Clerk Authentication ──────────────────────────────────────────────────
# Use pk_test_... for local dev, pk_live_... for production
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXX
CLERK_SECRET_KEY=sk_test_XXXXXXXXXXXX

# These tell Clerk where YOUR sign-in pages live (prevents redirect to hosted Clerk page)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/health/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/health/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/health/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/health/dashboard

# ─── Stripe Payments ───────────────────────────────────────────────────────
# Use sk_test_... for local dev to avoid real charges
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXX
STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXX
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXX

# ─── Application ───────────────────────────────────────────────────────────
# For local dev, use http://localhost:3000 so Stripe callbacks return here
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_DOMAIN=localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── RyzeHealth / Toothlens AI Detection ───────────────────────────────────
# Credentials for the Toothlens AI Oral Scanning API (via RyzeHealth)
# Set these in your Convex dashboard environment variables
RYZEHEALTH_COMPANY=idealhealth
RYZEHEALTH_ACCESS_KEY=your_access_key

# Shared secret for the inbound Toothlens scan-completed webhook
# (POST /api/toothlens/scan-completed). Share with Toothlens out-of-band.
# Set in the Next.js host env (Vercel/host), NOT Convex.
TOOTHLENS_WEBHOOK_SECRET=replace_with_long_random_string

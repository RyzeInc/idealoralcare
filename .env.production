# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION ENVIRONMENT — used automatically when NODE_ENV=production
# (i.e., when deployed to Vercel or running `npm run build && npm start`)
#
# Sensitive keys (CLERK_SECRET_KEY, STRIPE_SECRET_KEY, etc.) must be set in
# your hosting provider's environment variables panel (Vercel → Settings → Env Vars).
# They are NOT stored in this file.
# ─────────────────────────────────────────────────────────────────────────────

# Tell Clerk where your sign-in/sign-up pages live.
# This prevents Clerk from falling back to its hosted sign-in page.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/health/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/health/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/health/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/health/dashboard

# App — production values
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_APP_DOMAIN=getidealoh.com
NEXT_PUBLIC_APP_URL=https://getidealoh.com
